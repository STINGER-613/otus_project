#!/usr/bin/env bash

IP="192.168.189.136"

clear
echo -e "$slash\nНастройка логирования...\n$slash"
echo "Копирование конфигурации сети..."
sudo cp -r ~/otus_project/FILES/netplan/50-cloud-init.yaml /etc/netplan/
sleep 1s
sudo sed -i "6s/ip/$(echo $IP)/g" /etc/netplan/50-cloud-init.yaml
sudo netplan apply
sleep 1s

echo "Установка компонентов для логирования..."
sleep 1s
sudo apt-get install default-jdk -y 1>/dev/null; echo "[Java] -> Установлено!"
sudo dpkg -i ~/elasticsearch.deb 1>/dev/null; echo "[Elasticsearch] -> Установлено!"
sudo dpkg -i ~/filebeat.deb 1>/dev/null; echo "[Filebeat] -> Установлено!"
sudo dpkg -i ~/kibana.deb 1>/dev/null; echo "[Kibana] -> Установлено!"
sudo dpkg -i ~/logstash.deb 1>/dev/null; echo "[Logstash] -> Установлено!"

echo "Копирование конфигураций..."
sudo cp ~/otus_project/FILES/logs/jvm.options /etc/elasticsearch/jvm.options.d/
sudo cp ~/otus_project/FILES/logs/elasticsearch.yml /etc/elasticsearch/

sleep 1s

echo -e "\n\nГотово! IP адрес сервера $(echo $IP)\n$slash"
read -rp "Нажмите любую клавишу для продолжения!"
sleep 5s; sudo reboot
