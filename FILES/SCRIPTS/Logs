#!/usr/bin/env bash
IP_LOGS="192.168.189.135"

echo -e "$slash\nНастройка логирования...\n$slash"
sleep 1s
echo "Установка компонентов для логирования..."
sleep 1s
sudo apt-get install default-jdk -y 1>/dev/null; echo "[Java] -> Установлено!"
sudo apt-get install ~/elasticsearch*.deb -y 1>/dev/null; echo "[Elasticsearch] -> Установлено!"
sudo apt-get install ~/filebeat*.deb -y 1>/dev/null; echo "[Filebeat] -> Установлено!"
sudo apt-get install ~/kibana*.deb -y 1>/dev/null; echo "[Kibana] -> Установлено!"
sudo apt-get install ~/logstash*.deb -y 1>/dev/null; echo "[Logstash] -> Установлено!"

echo "Копирование конфигураций..."
sudo cp ~/otus_project/FILES/logs/jvm.options /etc/elasticsearch/jvm.options.d/
sudo cp ~/otus_project/FILES/logs/elasticsearch.yml /etc/elasticsearch/

echo -e "\n\nГотово! IP адрес сервера $(echo $IP_LOGS)\n$slash"
read -rp "Нажмите любую клавишу для продолжения!"

echo "Запуск служб..."
sudo systemctl daemon-reload
sudo systemctl enable --now elasticsearch.service 1>/dev/null; echo "[Elasticsearch]"
echo "Смена пароля на Elasticsearch..."
sudo /usr/share/elasticsearch/bin/elasticsearch-reset-password -u elastic -i
