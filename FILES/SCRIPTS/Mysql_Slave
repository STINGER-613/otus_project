#!/usr/bin/env bash
IP_SLAVE="192.168.189.134"

echo -e "$slash\nУстановка пакетов и их зависимостей...\n$slash"; sleep 2s
apt_tools=(git network-manager wget curl apache2 nginx mysql-server* net-tools iptables)
sudo systemctl disable apache2.service nginx.service mysql.service --now &>/dev/null
sudo systemctl stop apache2.service nginx.service mysql.service &>/dev/null
for i in ${apt_tools[@]}; do
        sudo apt-get install $i -y 1>/dev/null
        if [ $? -eq 0 ]; then
                echo "[$i] -> Установлено!"
        else
                echo "[$i] -> Не установлено!"
                sleep 2s; exit
        fi
done

sleep 1s
echo -e "\nComplite!\n$slash"
sleep 2s

clear
echo -e "$slash\nНастройка Mysql (slave)\n$slash"
sleep 1s

echo "Копирование конфигурации сети..."
sudo cp -r ~/otus_project/FILES/netplan/50-cloud-init.yaml /etc/netplan/
sleep 1s
sudo sed -i "6s/ip/$(echo $IP_SLAVE)/g" /etc/netplan/50-cloud-init.yaml
sudo netplan apply
sleep 1s

echo "Копирование конфигурации в mysql.conf.d..."
sleep 1s; sudo systemctl disable --now mysql.service
sleep 1s; sudo systemctl enable --now mysql.service
sudo cp ~/otus_project/FILES/mysql/mysqld.cnf /etc/mysql/mysql.conf.d/
sleep 1s
sudo sed -i "83s/OFF/ON/g" /etc/mysql/mysql.conf.d/mysqld.cnf
sudo sed -i "84s/OFF/ON/g" /etc/mysql/mysql.conf.d/mysqld.cnf
sudo sed -i "81s/numbers/2/g" /etc/mysql/mysql.conf.d/mysqld.cnf
sleep 1s

echo "Подключение к мастеру Mysql по адресу 192.168.189.133..."
cp ~/otus_project/FILES/mysql/slave.sql ~/
read -rp "Укажите номер 'log' Mysql-master > " e
read -rp "Укажите номер 'pos' Mysql-master > " r
sed -i "5s/log/$(echo $e)/g" ~/slave.sql
sed -i "6s/pos/$(echo $r)/g" ~/slave.sql
sleep 1s
sudo mysql < ~/slave.sql

echo -e "\n\nРеплика запущена в сторону 192.168.189.133!\nОжидается перезагрузка..."
#read -rp "Нажмите любую клавишу для продолжения!"
#sleep 5s; sudo reboot
