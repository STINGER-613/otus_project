#!/usr/bin/env bash
IP_NGINX="192.168.189.131"

echo -e "$slash\nУстановка пакетов и их зависимостей...\n$slash"; sleep 2s
apt_tools=(git network-manager wget curl apache2 nginx mysql-server* net-tools iptables)
sudo systemctl disable apache2.service nginx.service mysql.service --now &>/dev/null
sudo systemctl stop apache2.service nginx.service mysql.service &>/dev/null
for i in ${apt_tools[@]}; do
        sudo apt-get install $i -y 1>/dev/null
        if [ $? -eq 0 ]; then
                echo "[$i] -> Установлено!"
        else
                echo "[$i] -> Не установлено!"
                sleep 2s; exit
        fi
done

sleep 1s
echo -e "\nComplite!\n$slash"
sleep 2s

clear
echo -e "$slash\nНастройка Nginx (frontend)\n$slash"
sleep 1s
echo "Копирование конфигурации сети..."
sudo cp -r ~/otus_project/FILES/netplan/50-cloud-init.yaml /etc/netplan/
sleep 1s
sudo sed -i "6s/ip/$(echo $IP_NGINX)/g" /etc/netplan/50-cloud-init.yaml
sudo netplan apply
sleep 1s
echo "Копирование конфигурации nginx..."
sudo cp -r ~/otus_project/FILES/nginx/default /etc/nginx/sites-available/
sleep 1s

echo "Запуск служб Nginx..."
sleep 1s; sudo systemctl disable nginx.service --now
sleep 1s; sudo systemctl enable nginx.service --now
echo -e "\n\nГотово! IP адрес сервера $(echo $IP_NGINX)\nNginx настроен!\nОжидается перезагрузка...\n$slash"
#read -rp "Нажмите любую клавишу для продолжения!"
#sleep 5s; sudo reboot
