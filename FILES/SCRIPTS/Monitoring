#!/usr/bin/env bash

IP="192.168.189.135"

clear
echo -e "$slash\nНастройка Мониторинга (Grafana + Prometheus)\n$slash"
echo "Копирование конфигурации сети..."
sudo cp -r ~/otus_project/FILES/netplan/50-cloud-init.yaml /etc/netplan/
sleep 1s
sudo sed -i "6s/ip/$(echo $IP)/g" /etc/netplan/50-cloud-init.yaml
sleep 1s
echo "Установка компонентов мониторинга..."
sleep 1s
sudo apt install prometheus -y

echo "Копирование конфигураций..."
sudo cp -r ~/otus_project/FILES/monitoring 
sleep 1s

echo "Запуск служб..."
sleep 1s; sudo systemctl enable nginx.service; sudo systemctl start nginx.service
echo -e "\n\nГотово! IP адрес сервера $(echo $q)\nNginx настроен!\nОжидается перезагрузка...\n$slash"
sleep 5s; sudo reboot