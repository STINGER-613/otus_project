#!/usr/bin/env bash

clear
echo -e "$slash\nНастройка Мониторинга (Grafana + Prometheus)\n$slash"
sleep 1s
echo "Копирование конфигурации сети..."
sudo cp -r ~/otus_project/FILES/netplan/50-cloud-init.yaml /etc/netplan/
sleep 1s
sudo sed -i "6s/ip/192.168.189.136/g" /etc/netplan/50-cloud-init.yaml
sudo netplan apply
sleep 1s
echo "Установка компонентов мониторинга для Prometheus..."
sleep 1s
sudo apt install prometheus -y

echo "Копирование конфигураций Prometheus..."
sudo cp ~/otus_project/FILES/monitoring/prometheus.yml /etc/prometheus
sleep 1s

echo "Запуск служб..."
sleep 1s; sudo systemctl enable --now prometheus.service 
echo -e "\n\nГотово! IP адрес сервера $(echo $IP)\nPrometheus настроен!\n$slash"

echo "Установка компонентов мониторинга для Grafana..."
sleep 1s
echo "Скачивание 'deb' пакета версии 12.1.1..."
cd ~/
wget https://mirrors.huaweicloud.com/grafana/12.1.1/grafana-enterprise_12.1.1_16903967602_linux_amd64.deb -P ~/
echo -e "\n\nУстановка Grafana...\n"
sleep 1; sudo apt-get install ~/grafana-enterprise_12.1.1_16903967602_linux_amd64.deb -y
sleep 1s; sudo systemctl enable --now grafana-server.service

echo -e "\nУстановка завершена!\nСлужбы запущены!\nGrafana доступна по ссылке http://localhost:3000\n"
echo -e "Для импорта панели из файла .json требуется перейти по пути http://localhost:3000/dashboard/import\n\n"
read -rp "Нажмите любую клавишу для продолжения!"
sleep 5s; sudo reboot
